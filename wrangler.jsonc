{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splendid-homes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // preview_database_id keeps local builds on the existing local database file.
  "d1_databases": [
    { "binding": "D1", "database_name": "splendid-homes", "database_id": "fb2654bd-3b29-4a25-9269-981ff0057eb6", "preview_database_id": "00000000-0000-0000-0000-000000000000" },
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "splendid-homes", "database_id": "fb2654bd-3b29-4a25-9269-981ff0057eb6", "preview_database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "splendid-homes-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "splendid-homes-cache" }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "splendid-homes" }]
}
