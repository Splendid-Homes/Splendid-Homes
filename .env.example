# Copy to .env.local for local development. Never commit real values.
PAYLOAD_SECRET=            # random 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_ENV=           # "production" only on the live site (enables indexing)
RESEND_API_KEY=            # lead alert + password reset emails (resend.com, verified sending domain)
EMAIL_FROM=website@splendidhomes.ae
GOOGLE_SHEETS_ID=          # F27: spreadsheet ID from its URL; share the sheet with the service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=   # private key (PEM), with \n for line breaks
CLOUDFLARE_REMOTE_BINDINGS=   # "true" to run Payload CLI against the real D1/R2
